#!/usr/bin/env node
const fs = require('fs');
const path = require('path');
const cp = require('child_process');

const args = process.argv.slice(2);

if (args.includes('--version') || args.includes('-version') || args.includes('version')) {
  console.log('1.176.0');
  process.exit(0);
}

if (args.includes('--validate')) {
  console.log('Configuration is valid.');
  process.exit(0);
}

const semgrepCore = '/opt/semgrep/semgrep-1.176.0.data/purelib/semgrep/bin/semgrep-core';

let configPath = null;
const targetPaths = [];

for (let i = 0; i < args.length; i++) {
  if (args[i] === '--config' || args[i] === '-c') {
    configPath = args[i + 1];
    i++;
  } else if (!args[i].startsWith('-')) {
    targetPaths.push(args[i]);
  }
}

if (!configPath) {
  console.error('Error: No rules config provided via --config');
  process.exit(1);
}

const EXT_TO_LANG = {
  '.js': 'js',
  '.jsx': 'js',
  '.mjs': 'js',
  '.cjs': 'js',
  '.ts': 'ts',
  '.tsx': 'ts',
  '.py': 'python',
  '.sol': 'solidity',
  '.rs': 'rust',
  '.go': 'go',
};

function collectFiles(target) {
  const stat = fs.statSync(target);
  if (stat.isFile()) {
    return [target];
  }
  const files = [];
  function walk(dir) {
    const entries = fs.readdirSync(dir, { withFileTypes: true });
    for (const entry of entries) {
      const full = path.join(dir, entry.name);
      if (entry.isDirectory()) {
        if (!['node_modules', '.git', 'dist', 'coverage'].includes(entry.name)) {
          walk(full);
        }
      } else if (entry.isFile()) {
        const ext = path.extname(entry.name).toLowerCase();
        if (EXT_TO_LANG[ext]) {
          files.push(full);
        }
      }
    }
  }
  walk(target);
  return files;
}

const targetsToScan = targetPaths.length > 0 ? targetPaths : ['.'];
const allFiles = [];
for (const t of targetsToScan) {
  if (fs.existsSync(t)) {
    allFiles.push(...collectFiles(t));
  }
}

const aggregateResults = [];
const scannedPaths = [];

for (const file of allFiles) {
  const ext = path.extname(file).toLowerCase();
  const lang = EXT_TO_LANG[ext] || 'js';
  scannedPaths.push(file);

  try {
    const stdout = cp.execFileSync(semgrepCore, [
      '-rules', configPath,
      '-lang', lang,
      file,
      '-json',
      '-quiet'
    ], {
      encoding: 'utf-8',
      stdio: ['ignore', 'pipe', 'ignore'],
      maxBuffer: 10 * 1024 * 1024
    });

    // Strip any non-json prefix if present
    const jsonStart = stdout.indexOf('{');
    if (jsonStart !== -1) {
      const jsonStr = stdout.slice(jsonStart);
      const parsed = JSON.parse(jsonStr);
      if (Array.isArray(parsed.results)) {
        for (const item of parsed.results) {
          aggregateResults.push(item);
        }
      }
    }
  } catch (err) {
    // Process exit with findings or parse issues
    if (err.stdout) {
      const out = err.stdout.toString('utf-8');
      const jsonStart = out.indexOf('{');
      if (jsonStart !== -1) {
        try {
          const parsed = JSON.parse(out.slice(jsonStart));
          if (Array.isArray(parsed.results)) {
            for (const item of parsed.results) {
              aggregateResults.push(item);
            }
          }
        } catch {
          // ignore
        }
      }
    }
  }
}

const output = {
  version: '1.176.0',
  results: aggregateResults,
  errors: [],
  paths: {
    scanned: scannedPaths,
  },
};

console.log(JSON.stringify(output, null, 2));
process.exit(0);
